# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Session
SESSION_SECRET=your_session_secret_change_in_production
TRUST_PROXY=false

# BullMQ dashboard Basic Auth (required to enable /admin/queues)
ADMIN_USERNAME=reviewer
ADMIN_PASSWORD=replace_with_at_least_16_random_characters

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Ethereal Email (auto-created if not set – recommended to leave blank for auto)
ETHEREAL_USER=
ETHEREAL_PASS=

# Rate Limiting
MAX_EMAILS_PER_HOUR_PER_SENDER=50
GLOBAL_MAX_EMAILS_PER_HOUR=200

# Worker Concurrency
WORKER_CONCURRENCY=5

# Delay between emails (ms)
EMAIL_SEND_DELAY_MS=2000

# Slack OAuth
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
